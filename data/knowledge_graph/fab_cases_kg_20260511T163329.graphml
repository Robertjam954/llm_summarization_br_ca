      <data key="d8">{'tests_performed': {'value': 'ER, PR, HER2, and Ki-67 testing', 'evidence': 'The results of ER, PR, HER2, and Ki-67 testing will follow'}, 'ER': {'value': 'POSITIVE, ~70%, STRONG intensity', 'evidence': 'ESTROGEN RECEPTOR: ~70% STRONG; Since ≥1% of tumor cell nuclei express estrogen receptors, this tumor is considered to be ESTROGEN RECEPTOR POSITIVE'}, 'PR': {'value': 'POSITIVE, 10-15%, STRONG intensity', 'evidence': 'PROGESTERONE RECEPTOR: 10-15% STRONG; Since &lt;1% of tumor cell nuclei express progesterone receptors, this tumor is considered to be PROGESTERONE RECEPTOR POSITIVE'}, 'HER2_IHC': {'value': 'NEGATIVE, 1+', 'evidence': 'HER2: 1+; HER2: Incomplete membrane staining that is faint/barely perceptible and within &gt;10% of invasive tumor cells. Thus, this result indicates NEGATIVE HER2 by immunohistochemistry'}, 'HER2_ISH': {'value': 'Not reported', 'evidence': ''}}</data>
      <data key="d9">1.0</data>
