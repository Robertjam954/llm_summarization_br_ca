\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 who is an Applied AI engineer.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:06\cb1 \
\pard\pardeftab720\partightenfactor0
