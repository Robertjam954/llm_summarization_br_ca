\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:11\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 on our laptops, on the web, and in company's cloud storage.\cb1 \
