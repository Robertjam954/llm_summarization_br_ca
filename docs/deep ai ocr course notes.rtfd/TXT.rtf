\cf7 \cb6 \strokec7 1:55\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 meaning is encoded in layout structure and spatial relationships.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:59\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 It uses custom visual models that directly interpret\cb1 \
\pard\pardeftab720\qc\partightenfactor0
