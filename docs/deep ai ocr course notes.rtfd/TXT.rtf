\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:47\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 with LLM-based reasoning.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:49\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 Then, you'll learn to use Agentic Document Extraction,\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:53\cb1 \
\pard\pardeftab720\partightenfactor0
