\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:01\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 who's Senior Director of Applied AI, and Andrea Kropp,\cb1 \
\pard\pardeftab720\qc\partightenfactor0
