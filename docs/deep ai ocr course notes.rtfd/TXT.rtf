\cf7 \cb6 \strokec7 0:30\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 and then add techniques to detect document structure\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:33\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 and identify visual components\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:35\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 such as tables with complex formatting like merged cells\cb1 \
\pard\pardeftab720\qc\partightenfactor0
