\cf7 \cb6 \strokec7 1:30\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 such as the document structure or tables or forms,\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:33\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 or even what is the reading\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:35\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 order of different elements of a document.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:38\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 Landing AI's ADE takes a different approach.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:41\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 It treats each page of a document as an image\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:45\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 and breaks that image down into parts\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:47\cb1 \
\pard\pardeftab720\partightenfactor0
