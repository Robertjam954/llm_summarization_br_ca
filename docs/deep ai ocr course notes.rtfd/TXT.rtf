\cf7 \cb6 \strokec7 1:44\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 Captions detached from figures,\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:46\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 and reading order becomes unpredictable.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:49\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 For complex documents, financial reports,\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:52\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 research papers, and legal contracts.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 1:54\cb1 \
\pard\pardeftab720\partightenfactor0
