\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:18\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 that transform your complex documents\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:20\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 into LLM-ready markdown text and extracts information.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:23\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 \strokec2 for analysis.\cb1 \
\pard\pardeftab720\qc\partightenfactor0
\cf7 \cb6 \strokec7 0:26\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb4 \strokec2 You begin by explaining traditional OCR which only extracts text\
